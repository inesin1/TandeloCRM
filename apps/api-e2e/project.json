{
  "name": "api-e2e",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "implicitDependencies": ["api"],
  "targets": {
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/api-e2e",
        "command": "tsc --noEmit -p tsconfig.spec.json"
      }
    },
    "e2e": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/coverage/apps/api-e2e"],
      "dependsOn": ["api:build"],
      "options": {
        "command": "vitest --config apps/api-e2e/vitest.config.mts"
      }
    }
  }
}

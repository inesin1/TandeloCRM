# Tandelo Environment Configuration

# Runtime environment (development | production | test)
NODE_ENV=development

# Database connection URL
# Local dev: postgresql://postgres:postgres@localhost:5432/tandelo
# HomeLab shared Postgres: postgresql://<db_user>:<db_password>@homelab-postgres:5432/<db_name>
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tandelo

# Secret key for JWT signing and AES-256-GCM encryption of saved Copilot credentials
# Must be at least 32 characters long. Keep stable across restarts and database backups.
# Generate with: openssl rand -hex 32
JWT_SECRET=

# Host loopback port for Docker Compose web publishing (default: 3103)
APP_HOST_PORT=3103

# Copilot AI integration (optional, disabled by default)
COPILOT_ENABLED=false
COPILOT_API_FORMAT=responses
COPILOT_BASE_URL=https://api.openai.com/v1
COPILOT_API_KEY=
COPILOT_MODEL=
# OPENAI_API_KEY is also accepted for the default OpenAI base URL

# Initial Admin Bootstrap (used ONLY by `pnpm db:seed-admin` via tooling container, not read during normal runtime)
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=
